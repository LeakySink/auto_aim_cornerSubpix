# 源文件统一 LF（本仓库历史基线 76f6893 就是 LF，core.autocrlf=false）
# 见 docs/line_endings.md 的背景说明
* text=auto eol=lf

*.cpp   text eol=lf
*.hpp   text eol=lf
*.h     text eol=lf
*.c     text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.txt   text eol=lf

# 二进制文件不做行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.onnx  binary
*.xml   binary
*.bin   binary
*.rlog  binary
*.mp4   binary
*.avi   binary
